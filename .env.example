# ══════════════════════════════════════════════════
#   OVOZ BATTLE BOT — .env namunasi
#   Railway Variables ichida shu o'zgaruvchilarni
#   sozlang (Settings → Variables)
# ══════════════════════════════════════════════════

# Telegram botdan olingan token (@BotFather)
BOT_TOKEN=1234567890:AABBCCDDEEFFaabbccddeeff1234567890

# Botning username-i (@ belgisisiz)
BOT_USERNAME=mybattlebot

# Railway domeningiz (https://... ko'rinishida)
# Misol: https://battlebot-production.up.railway.app
MINIAPP_URL=https://your-app.up.railway.app

# Admin Telegram ID (https://t.me/userinfobot dan oling)
ADMIN_ID=123456789

# Server porti (Railway avtomatik o'rnatadi, o'zgartirmang)
PORT=3000

# NODE_ENV (production yoki development)
NODE_ENV=production
